# Copy this file to `.env` and fill it in.
# `.env` is gitignored and must never be committed.

# For the summariser models (search/). Only needed when indexing.
OPENROUTER_API_KEY=sk-or-...

# --- serving the app over the internet -------------------------------------

# SEED ONLY, for the very first admin account.
#
# Accounts live in the `users` table inside shabads.db, not here. These two are
# read once, by tools/migrate_multiuser.py, to create the first admin. After
# that they are ignored: change your password in the app, add people from the
# control panel, and expect these to go stale. They are kept only so a fresh
# install has something to log in with.
APP_USER=keertan
APP_PASSWORD=

# Push notifications for the tunnel url (https://ntfy.sh -- free, no account).
# Subscribe to this exact topic in the ntfy app on your phone.
#
# THE TOPIC NAME IS THE ONLY SECRET. Anyone who knows it can read your
# notifications, which contain the address of your library. Use a random one.
NTFY_TOPIC=gurbanify-changeme
