# Copy this file to `.env` and fill it in.
# `.env` is gitignored and must never be committed.

# For the summariser models (search/). Only needed when indexing.
OPENROUTER_API_KEY=sk-or-...

# --- serving the app over the internet -------------------------------------

# OPTIONAL, and only ever a seed for the very first admin account.
#
# Accounts live in the `users` table inside shabads.db, not here. Once you have
# an account, DELETE THESE TWO LINES -- nothing reads them, and a stale password
# sitting in a file is worse than no password in a file.
#
# They exist for one case: a brand-new database, where
# tools/migrate_multiuser.py reads them to create the first admin. You can pass
# --admin and --password to that script instead and never set them at all.
#
# APP_USER=
# APP_PASSWORD=

# Push notifications for the tunnel url (https://ntfy.sh -- free, no account).
# Subscribe to this exact topic in the ntfy app on your phone.
#
# THE TOPIC NAME IS THE ONLY SECRET. Anyone who knows it can read your
# notifications, which contain the address of your library. Use a random one.
NTFY_TOPIC=gurbanify-changeme
